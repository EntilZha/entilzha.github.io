---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatBlogDate, postUrl } from "../../utils/date";
import { excerpt } from "../../utils/excerpt";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Curated description when present, otherwise an auto-excerpt of the post body.
const preview = (post: (typeof posts)[number]) =>
  post.data.description ?? excerpt(post.body ?? "");
---

<Layout title="Blog · Pedro Rodriguez" description="Writing on machine learning, NLP, software, and the outdoors.">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8">Blog</h1>
  <div class="space-y-6">
    {
      posts.map((post) => {
        const href = postUrl(post.data.date, post.data.slug);
        return (
          <article class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/50 p-6 transition-shadow hover:shadow-md">
            <time
              class="text-sm text-gray-500 dark:text-gray-400"
              datetime={post.data.date.toISOString()}
            >
              {formatBlogDate(post.data.date)}
            </time>
            <h2 class="mt-1 text-xl font-semibold">
              <a
                href={href}
                class="text-gray-900 dark:text-gray-100 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
              >
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-gray-600 dark:text-gray-400">{preview(post)}</p>
            <div class="mt-4 flex items-center justify-between gap-3 text-sm">
              <a href={href} class="font-medium text-cyan-600 dark:text-cyan-400 hover:underline">
                Read more &rarr;
              </a>
              {post.data.tags.length > 0 && (
                <span class="flex flex-wrap justify-end gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-gray-100 dark:bg-gray-700 px-2 py-0.5 text-xs text-gray-600 dark:text-gray-300">
                      {tag}
                    </span>
                  ))}
                </span>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Layout>
