---
import Layout from "../layouts/Layout.astro";
import BibtexEntry from "../components/BibtexEntry.astro";
import { publicationSections } from "../data/publications";

/** Join authors with Oxford "and", bolding Pedro. Names are trusted data. */
function authorsHtml(authors: string[]): string {
  const fmt = (a: string) =>
    a === "Pedro Rodriguez" ? `<strong>${a}</strong>` : a;
  if (authors.length === 0) return "";
  if (authors.length === 1) return fmt(authors[0]);
  return authors.slice(0, -1).map(fmt).join(", ") + ", and " + fmt(authors[authors.length - 1]);
}

// Scholar profile links shown at the top of the page.
const profileLinks = [
  { name: "Google Scholar", href: "https://scholar.google.com/citations?user=JjpA4qwAAAAJ&hl=en" },
  { name: "Semantic Scholar", href: "https://www.semanticscholar.org/author/145009056" },
];

// Papers with a dedicated project page on this site (keyed by bib id "@<key>").
// When present, the title links here instead of the external paper URL.
const dedicatedPages: Record<string, string> = {
  "@rodriguez2020curiosity": "/curiosity/",
  "@rodriguez2020leaderboard": "/leaderboard-acl2021/",
  "@rodriguez2023fire": "/multimodal-retrieval-evaluation/",
  "@rodriguez2022clustering": "/multidim-irt/",
  "@rodriguez2021paradigms": "/paradigms-emnlp2021/",
};

// Canonical ACL Anthology pages for papers whose bib URL points elsewhere
// (arXiv / publisher / hosted PDF). Verified on aclanthology.org.
const anthologyOverride: Record<string, string> = {
  "@rodriguez2020curiosity": "https://aclanthology.org/2020.emnlp-main.655/",
  "@rodriguez2021paradigms": "https://aclanthology.org/2021.emnlp-main.758/",
  "@feng2018rawr": "https://aclanthology.org/D18-1407/",
  "@rodriguez2023fire": "https://aclanthology.org/2023.findings-eacl.3/",
  "@Wallace:Rodriguez:Feng:Yamada:Boyd-Graber-2019": "https://aclanthology.org/Q19-1029/",
};

/**
 * Build the external source buttons (arXiv, ACL Anthology) and a direct PDF
 * link for an entry. The ACL Anthology page comes from an override or the
 * entry URL; its PDF is the page + ".pdf". arXiv /abs/ maps to /pdf/.
 */
function sourceLinks(id: string, url: string): {
  buttons: { label: string; href: string }[];
  pdfUrl: string | null;
} {
  const u = url.replace(/\/$/, "");
  const buttons: { label: string; href: string }[] = [];

  const arxiv = u.match(/arxiv\.org\/abs\/(.+)$/i);
  if (arxiv) buttons.push({ label: "arXiv", href: `https://arxiv.org/abs/${arxiv[1]}` });

  let acl = anthologyOverride[id];
  if (!acl && /(^|\/\/)([^/]*\.)?aclanthology\.org\//.test(u)) acl = u;
  acl = acl ? acl.replace(/\/$/, "") : acl;
  if (acl) buttons.push({ label: "ACL Anthology", href: acl });

  let pdfUrl: string | null = null;
  if (acl) pdfUrl = `${acl}.pdf`;
  else if (arxiv) pdfUrl = `https://arxiv.org/pdf/${arxiv[1]}`;
  else if (u.toLowerCase().endsWith(".pdf")) pdfUrl = url;

  return { buttons, pdfUrl };
}

// schema.org structured data: an ItemList of the publications for scholarly
// indexing. Project pages are linked where available, else the paper URL.
const publicationsLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: publicationSections
    .flatMap((s) => s.entries)
    .map((e, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "ScholarlyArticle",
        headline: e.title,
        datePublished: e.year,
        url: e.url || undefined,
        author: e.authors.map((name) => ({ "@type": "Person", name })),
        isPartOf: e.source || undefined,
      },
    })),
};
---

<Layout title="Publications · Pedro Rodriguez" description="Publications by Pedro Rodriguez.">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Publications</h1>

  <div class="mb-10 flex flex-wrap gap-3">
    {
      profileLinks.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:border-cyan-300 hover:bg-cyan-50 hover:text-cyan-700"
        >
          <svg viewBox="0 0 640 512" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path d="M320 32c-8.1 0-16.1 1.4-23.7 4.1L15.8 137.4C6.3 140.9 0 149.9 0 160s6.3 19.1 15.8 22.6l57.9 20.9C57.3 229.3 48 259.8 48 291.9v28.1c0 28.4-10.8 57.7-22.3 80.8-6.5 13-13.9 25.8-22.5 37.6C0 442.7-.9 448.3 .9 453.4s6 8.9 11.2 10.2l64 16c4.2 1.1 8.7 .3 12.4-2s6.3-6.1 7.1-10.4c8.6-42.8 4.3-81.2-2.1-109.6C90.3 344.3 86 329.8 80 316.5V291.9c0-30.2 10.2-58.7 27.9-81.5c12.9-15.5 29.6-28 49.2-35.7l157-61.7c8.2-3.2 17.5 .8 20.7 9s-.8 17.5-9 20.7l-157 61.7c-12.4 4.9-23.3 12.4-32.2 21.6l159.6 57.6c7.6 2.7 15.6 4.1 23.7 4.1s16.1-1.4 23.7-4.1L624.2 182.6c9.5-3.4 15.8-12.5 15.8-22.6s-6.3-19.1-15.8-22.6L343.7 36.1C336.1 33.4 328.1 32 320 32zM128 408c0 35.3 86 72 192 72s192-36.7 192-72L496.7 262.6 354.5 314c-11.1 4-22.8 6-34.5 6s-23.5-2-34.5-6L143.3 262.6 128 408z" />
          </svg>
          {p.name}
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 opacity-60" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      ))
    }
  </div>

  {
    publicationSections.map((section) => (
      <section class="mb-14">
        <h2 class="flex items-center gap-3 text-2xl font-bold text-gray-900 border-b border-gray-200 pb-2 mb-5">
          {section.heading}
          <span class="text-sm font-normal text-gray-400">
            ({section.entries.length})
          </span>
        </h2>
        <ul class="divide-y divide-gray-200">
          {section.entries.map((e) => {
            const page = dedicatedPages[e.id];
            const titleHref = page ?? (e.url || null);
            const { buttons, pdfUrl } = sourceLinks(e.id, e.url);
            return (
              <li class="py-4 first:pt-0 last:pb-0 text-gray-700 leading-relaxed">
                <span set:html={authorsHtml(e.authors)} />.{" "}
                {titleHref ? (
                  <a
                    href={titleHref}
                    target={page ? undefined : "_blank"}
                    rel={page ? undefined : "noopener noreferrer"}
                    class="font-semibold text-cyan-700 hover:text-cyan-900 hover:underline"
                  >
                    {e.title}
                  </a>
                ) : (
                  <span class="font-semibold text-gray-900">{e.title}</span>
                )}
                . <span class="italic">{e.source}</span>
                {e.source ? ", " : ""}
                {e.year}.{" "}
                <span class="mt-1 flex flex-wrap items-center gap-2">
                  {e.award && (
                    <span class="inline-flex items-center gap-1 rounded border border-amber-300 bg-amber-50 px-1.5 py-0.5 text-xs font-semibold text-amber-700">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                        <path
                          fill-rule="evenodd"
                          d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      {e.award}
                    </span>
                  )}
                  {buttons.map((b) => (
                    <a
                      href={b.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 rounded border border-gray-300 px-1.5 py-0.5 text-xs font-semibold text-gray-600 transition-colors hover:border-cyan-400 hover:text-cyan-700"
                    >
                      <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                        <path
                          fill-rule="evenodd"
                          d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      {b.label}
                    </a>
                  ))}
                  {pdfUrl && (
                    <a
                      href={pdfUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 rounded border border-gray-300 px-1.5 py-0.5 text-xs font-semibold text-gray-600 transition-colors hover:border-cyan-400 hover:text-cyan-700"
                      aria-label="Download PDF"
                    >
                      <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm0 2 4 4h-4V4zM8.5 13.5h1a1.5 1.5 0 0 1 0 3h-1V18H7.5v-4.5h1zm0 1v1h1a.5.5 0 0 0 0-1h-1zm5 -1h1.2c1 0 1.8 .8 1.8 1.8v.9c0 1-.8 1.8-1.8 1.8H13.5v-4.5zm1 1v2.5h.2a.8.8 0 0 0 .8-.8v-.9a.8.8 0 0 0-.8-.8h-.2z" />
                      </svg>
                      PDF
                    </a>
                  )}
                  {e.code && (
                    <a
                      href={e.code}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 rounded border border-gray-300 px-1.5 py-0.5 text-xs font-semibold text-gray-600 transition-colors hover:border-cyan-400 hover:text-cyan-700"
                    >
                      <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                        <path
                          fill-rule="evenodd"
                          d="M6.28 5.22a.75.75 0 010 1.06L2.56 10l3.72 3.72a.75.75 0 01-1.06 1.06L.97 10.53a.75.75 0 010-1.06l4.25-4.25a.75.75 0 011.06 0zm7.44 0a.75.75 0 011.06 0l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06L17.44 10l-3.72-3.72a.75.75 0 010-1.06zM11.377 2.011a.75.75 0 01.612.867l-2.5 14.5a.75.75 0 01-1.478-.255l2.5-14.5a.75.75 0 01.866-.612z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      Code
                    </a>
                  )}
                  <BibtexEntry bibtex={e.bibtex} />
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }

  <script type="application/ld+json" set:html={JSON.stringify(publicationsLd)} is:inline />
</Layout>
