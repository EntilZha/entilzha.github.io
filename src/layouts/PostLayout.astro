---
import Layout from "./Layout.astro";
import { formatBlogDate } from "../utils/date";

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
}

const { title, date, tags = [], description } = Astro.props;
---

<Layout title={`${title} · Pedro Rodriguez`} description={description}>
  <article
    class="prose prose-gray dark:prose-invert max-w-none prose-a:text-cyan-600 dark:prose-a:text-cyan-400 prose-headings:font-semibold prose-img:rounded-lg"
  >
    <header class="not-prose mb-8">
      <a href="/blog/" class="text-sm text-cyan-600 dark:text-cyan-400 hover:underline">&larr; All posts</a>
      <h1 class="mt-3 text-3xl font-bold text-gray-900 dark:text-gray-100">{title}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={date.toISOString()}>{formatBlogDate(date)}</time>
        {tags.length > 0 && (
          <span class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-full bg-gray-100 dark:bg-gray-800 px-2 py-0.5 text-xs">{tag}</span>
            ))}
          </span>
        )}
      </div>
    </header>
    <slot />
  </article>
</Layout>
